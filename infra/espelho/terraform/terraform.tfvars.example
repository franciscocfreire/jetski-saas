# Copie para terraform.tfvars (ignorado pelo git) e preencha.
# Credenciais NÃO vão aqui: OCI pelo ~/.oci/config, Cloudflare por
# CLOUDFLARE_API_TOKEN no ambiente.

tenancy_ocid              = "ocid1.tenancy.oc1..COLE_AQUI"
prod_tunnel_id            = "00000000-0000-0000-0000-000000000000" # UUID do túnel de PRODUÇÃO
ssh_cidr_permitido        = "203.0.113.10/32"                      # seu IP: curl -s https://ifconfig.me
ssh_chave_publica_arquivo = "~/.ssh/id_ed25519.pub"

# Opcionais (os padrões reproduzem produção)
# git_ref               = "main"       # use o commit que está em produção
# oci_perfil            = "DEFAULT"    # perfil do ~/.oci/config (outra conta = outro perfil)
# oci_regiao            = "sa-saopaulo-1"
# ad_indice             = 0            # "Out of host capacity"? tente 1 ou 2 (regiões com 3 ADs)
# platform_admin_emails = "voce@exemplo.com"
# ligada                = true
