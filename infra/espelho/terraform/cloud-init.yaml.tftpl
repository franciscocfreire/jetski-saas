#cloud-config
# Espelho de carga — gerado pelo Terraform (infra/espelho/terraform).
# Mínimo de propósito: grava a entrada, clona o repositório no commit pedido e
# chama infra/espelho/provisionar-vm.sh, que é versionado e testável fora daqui.

package_update: true
packages:
  - ca-certificates
  - curl
  - git

write_files:
  - path: /etc/meujet-espelho/entrada.env
    owner: root:root
    permissions: "0600"
    content: |
      DOMINIO=${dominio}
      CLOUDFLARE_TUNNEL_TOKEN=${tunnel_token}
      ESPELHO_TUNNEL_ID=${tunnel_id}
      PROD_TUNNEL_ID=${prod_tunnel_id}
      PLATFORM_ADMIN_EMAILS=${platform_admin_emails}
      DOCKER_CE_VERSAO=${docker_ce_versao}
      CONTAINERD_VERSAO=${containerd_versao}
      BUILDX_VERSAO=${buildx_versao}
      COMPOSE_VERSAO=${compose_versao}

runcmd:
  # Numa VCN recém-criada o resolvedor (169.254.169.254) pode levar minutos para
  # responder. Visto em 16/set/2026 numa conta nova: o DNS falhava 28 s após o
  # boot, o clone não aconteceu e nada no provisionamento chegou a rodar.
  # Espera até 10 min pelo DNS antes de seguir.
  - [bash, -c, "for i in $(seq 1 120); do getent hosts github.com >/dev/null && exit 0; sleep 5; done; echo 'DNS indisponivel apos 10 min' >&2; exit 1"]
  - [runuser, -u, ubuntu, --, git, clone, "${repo_url}", /home/ubuntu/jetski]
  - [runuser, -u, ubuntu, --, git, -C, /home/ubuntu/jetski, checkout, "${git_ref}"]
  # Sem o repositório, o provisionar-vm.sh nem existe e ninguém grava marcador:
  # o `terraform output status_provisionamento` ficaria mudo para sempre.
  - [bash, -c, "test -f /home/ubuntu/jetski/infra/espelho/provisionar-vm.sh || { mkdir -p /var/lib/meujet-espelho && printf 'etapa=clone do repositorio (cloud-init)\\nver=/var/log/cloud-init-output.log\\n' > /var/lib/meujet-espelho/FALHOU; }"]
  - [bash, /home/ubuntu/jetski/infra/espelho/provisionar-vm.sh]
