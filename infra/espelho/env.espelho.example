# =============================================================================
# Variáveis do ESPELHO de testes de carga.
#
# NÃO copie o .env de produção e "ajuste": gere este arquivo do zero com
#   ./infra/espelho/gerar-env.sh <dominio-do-espelho>
# que preenche os segredos com valores aleatórios novos. Copiar o de produção
# traz junto três coisas que causam estrago real (ver infra/espelho/README.md):
# o token do túnel Cloudflare, as credenciais do Gmail e o destino do backup.
#
# O deploy.sh roda infra/espelho/preflight.sh antes de tocar em qualquer
# container e aborta se algo aqui apontar para o mundo real.
# =============================================================================

# Liga a camada docker-compose.espelho.yml e o preflight no deploy.sh.
MEUJET_AMBIENTE=espelho

# --- Hostnames ---------------------------------------------------------------
# Domínio PRÓPRIO do espelho, com a mesma estrutura de subdomínios de produção.
# Subdomínios de meujet.com.br NÃO servem (ver README, "Por que um domínio próprio").
PUBLIC_URL=https://www.__DOMINIO__
APP_PUBLIC_URL=https://app.__DOMINIO__
PORTAL_PUBLIC_URL=https://cliente.__DOMINIO__
CONSOLE_PUBLIC_URL=https://admin.__DOMINIO__
SSO_PUBLIC_URL=https://sso.__DOMINIO__

# --- Cloudflare Tunnel -------------------------------------------------------
# Um túnel NOVO, criado só para o espelho. O token de produção aqui faz o
# cloudflared do espelho entrar como réplica do túnel de PRODUÇÃO — e a
# Cloudflare passa a mandar usuários reais de meujet.com.br para esta máquina.
CLOUDFLARE_TUNNEL_TOKEN=__COLE_O_TOKEN_DO_TUNEL_DO_ESPELHO__
# Confirmação consciente: o UUID do túnel (Zero Trust → Networks → Tunnels).
# O preflight decodifica o token e exige que bata com este valor.
ESPELHO_TUNNEL_ID=__UUID_DO_TUNEL_DO_ESPELHO__
# Opcional, e recomendado: o UUID do túnel de PRODUÇÃO. Se o token acima for
# dele, o preflight recusa.
PROD_TUNNEL_ID=

# --- E-mail: tudo para o Mailpit, nada para fora ------------------------------
# Links de ativação de conta aparecem na UI do Mailpit (ssh -L 8025, ver README).
PLATFORM_SMTP_HOST=mailpit
PLATFORM_SMTP_PORT=1025
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=nao-responda@__DOMINIO__
# Vazios de propósito: o preflight reprova qualquer credencial de Gmail aqui.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Backup: nenhum -----------------------------------------------------------
# O espelho só tem dado sintético e é descartável. O deploy.sh não instala o
# timer de backup neste ambiente, e o preflight reprova um destino off-site —
# o backup.sh faz `rclone sync`, que APAGA do destino o que não existe na
# origem: apontado para o remoto de produção, ele limparia os backups reais.
BACKUP_RCLONE_REMOTE=

# --- Login social: desligado ---------------------------------------------------
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Operador de plataforma do espelho ----------------------------------------
# Quem aprova o tenant de carga. Precisa já ter conta NO ESPELHO (ver README,
# "Primeiro operador"). Promovido no boot do backend.
PLATFORM_ADMIN_EMAILS=

# --- Segredos (o gerar-env.sh preenche; NUNCA reaproveite os de produção) -----
POSTGRES_PASSWORD=__GERADO__
JETSKI_APP_DB_PASSWORD=__GERADO__
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__GERADO__
KEYCLOAK_BACKOFFICE_SECRET=obsoleto
NEXTAUTH_SECRET=__GERADO__
MINIO_ROOT_USER=jetski-minio
MINIO_ROOT_PASSWORD=__GERADO__
MINIO_BUCKET=jetski-docs
JETSKI_SECRET_KEY=__GERADO__
JETSKI_SECRET_KEY_PREVIOUS=
JWT_MAGIC_LINK_SECRET=__GERADO__

# --- Observabilidade ----------------------------------------------------------
# O espelho PRECISA do stack de observabilidade: é o instrumento do teste.
MEUJET_BACKUP_DIR=/home/ubuntu/backups/meujet
GRAFANA_ADMIN_PASSWORD=__GERADO__
# Alertas vão para o Mailpit junto com o resto. Um stress test dispara
# "Backend fora do ar" de propósito — isso não pode chegar na caixa de quem
# responde por produção.
GRAFANA_ALERT_EMAIL=alertas@__DOMINIO__
GRAFANA_OIDC_CLIENT_SECRET=
GRAFANA_ADMIN_EMAILS=
