# Console da Plataforma — variáveis de ambiente
#
# Em docker/túnel quem injeta estas vars é o docker-compose (serviço `console`).
# Este arquivo serve para rodar standalone: npm run dev (porta 3005).

# Backend pela rede interna do Docker (server components / route handlers)
API_INTERNAL_URL=http://backend:8090/api

# NextAuth — raiz do subdomínio do console
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=jetski-dev-secret-change-in-production-123456
AUTH_TRUST_HOST=true

# Keycloak — client público próprio do console (PKCE, sem secret)
KEYCLOAK_CLIENT_ID=jetski-platform-console
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/jetski-saas
